# ==============================================================
#  AI Engineering Team — Backend
#  Copy this file to `.env` and fill in the values.
#  Every variable read by the backend is documented below.
# ==============================================================

# --------------------------------------------------------------
# Runtime
# --------------------------------------------------------------

# Port the HTTP server binds to (see src/server.ts)
PORT=4000

# Interface the HTTP server binds to
HOST=0.0.0.0

# development | production | test
NODE_ENV=development

# Comma separated list of browser origins allowed by CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# --------------------------------------------------------------
# PostgreSQL (Prisma)
# --------------------------------------------------------------

# Used by Prisma migrations and by the PrismaPg driver at runtime
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_engineering_team?schema=public

# --------------------------------------------------------------
# Redis (cache, rate limiting, BullMQ queues)
# --------------------------------------------------------------

# Primary connection string used by BullMQ and the rate limiter
REDIS_URL=redis://localhost:6379

# Individual settings (used when REDIS_URL is not sufficient)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --------------------------------------------------------------
# Authentication (JWT)
# --------------------------------------------------------------

# Secret used to sign access tokens — use a long random string
JWT_SECRET=replace-me-with-a-long-random-string

# Access token lifetime
JWT_EXPIRES_IN=7d

# Refresh token lifetime (reserved for refresh token support)
JWT_REFRESH_EXPIRES_IN=30d

# --------------------------------------------------------------
# SMTP (transactional email, used by the email worker)
# --------------------------------------------------------------

SMTP_HOST=smtp.example.com
SMTP_PORT=587

# "true" for implicit TLS (port 465), "false" for STARTTLS
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# From header for outgoing mail
SMTP_FROM="AI Engineering Team <no-reply@example.com>"

# --------------------------------------------------------------
# Queues (BullMQ)
# --------------------------------------------------------------

# Name of the email queue consumed by src/workers/email.worker.ts
QUEUE_NAME=email-queue

# Redis key prefix used by BullMQ
QUEUE_PREFIX=bull

# Whether finished jobs are removed from Redis
QUEUE_REMOVE_ON_COMPLETE=true
QUEUE_REMOVE_ON_FAIL=false

# --------------------------------------------------------------
# Rate limiting (src/config/ratelimit.config.ts)
# --------------------------------------------------------------

# Sliding window length in milliseconds
RATE_LIMIT_WINDOW_MS=60000

# Maximum requests per window for the AI endpoints
RATE_LIMIT_MAX_REQUESTS=30

# --------------------------------------------------------------
# LLM provider (src/ai/llm.ts)
# --------------------------------------------------------------

# Provider used by chat/completions and the workflow graph:
#   anthropic | openai
LLM_PROVIDER=anthropic

# Model override. When LLM_PROVIDER is unset this is used for the
# default provider; set it together with LLM_PROVIDER to be explicit.
#   anthropic → claude-sonnet-4-6, claude-opus-4-6, claude-haiku-4-5, ...
#   openai    → gpt-5.6-sol, gpt-5.6-terra, gpt-5.5, gpt-4.1, ...
LLM_MODEL=claude-sonnet-4-6

# Optional base URL override for proxies, gateways or local models.
# Leave empty to use the provider default:
#   anthropic → https://api.anthropic.com
#   openai    → https://api.openai.com/v1
# The client appends /v1/messages or /v1/chat/completions as needed.
LLM_BASE_URL=

# Sampling temperature (0 – 2). Reasoning models ignore it.
LLM_TEMPERATURE=0.2

# Maximum tokens per completion
LLM_MAX_TOKENS=2048

# API keys — only the key for the selected provider is required
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --------------------------------------------------------------
# MCP server registry (src/services/mcp.service.ts)
# --------------------------------------------------------------

# Servers registered from configuration at boot. Either a JSON array
# or a JSON object map, e.g.:
#   [{"name":"filesystem","transport":"stdio","command":"npx",
#     "args":["-y","@modelcontextprotocol/server-filesystem","/tmp"]}]
# HTTP/SSE servers need a "url", stdio servers need a "command".
MCP_SERVERS=

# Optional path to a JSON config file with the same shape, or a
# {"mcpServers": {...}} wrapper (Claude Desktop style).
MCP_CONFIG_PATH=

# Timeout for HTTP/SSE ping checks in milliseconds
MCP_PING_TIMEOUT_MS=3000
